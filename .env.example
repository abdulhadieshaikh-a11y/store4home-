# --- Database (your existing Supabase project) ---------------------------------
# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543).
# Server-only. If you use Vercel's Supabase integration, POSTGRES_URL is used automatically.
DATABASE_URL=postgres://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# --- Email (Resend) -------------------------------------------------------------
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Store4Home <orders@your-verified-domain.com>
# Receives new-order alerts (can also be set in Admin -> Settings, which takes priority).
STORE_OWNER_EMAIL=owner@your-domain.com

# --- Admin dashboard login ------------------------------------------------------
ADMIN_PASSWORD=choose-a-long-unique-password
# Random string, at least 32 characters (e.g. `openssl rand -hex 32`).
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# --- Links in emails --------------------------------------------------------------
SITE_URL=https://your-store-domain.com

# --- Online payment gateway (optional, not connected yet) -------------------------
# PAYMENT_GATEWAY=
