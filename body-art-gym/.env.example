# Public URL of the deployed site (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Enquiry form delivery (configure at least one) ─────────────────────────
# Option A: any webhook that accepts JSON (Formspree, Make, Zapier, Slack, etc.)
ENQUIRY_WEBHOOK_URL=

# Option B: email via Resend (https://resend.com)
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=Body Art Gym <enquiries@your-verified-domain.com>
