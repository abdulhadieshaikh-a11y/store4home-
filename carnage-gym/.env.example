# Public URL of the deployed site (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.carnagegym.pk

# Contact form delivery (optional). When both are set, enquiries are emailed via Resend.
# Without them the form still validates, but in production it will show an error
# asking visitors to call instead — so enquiries are never silently lost.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Carnage Gym <website@yourdomain.com>
